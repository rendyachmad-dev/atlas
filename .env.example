# Atlas API Keys
# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# LLM Provider: "anthropic" or "groq"
LLM_PROVIDER=groq

# API key for the LLM provider
# Groq: gsk_...  (get at console.groq.com)
# Anthropic: sk-ant-...  (get at console.anthropic.com)
LLM_API_KEY=your-api-key-here

# Model name
# Groq: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
# Anthropic: claude-sonnet-5, claude-opus-4-8
LLM_MODEL=llama-3.3-70b-versatile

# Database URL (optional, defaults to local postgres)
DATABASE_URL=postgres://localhost:5432/rss_atlas?sslmode=disable