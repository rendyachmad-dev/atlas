# Atlas API Keys
# Copy this file to .env and fill in your keys.
# Never commit .env to git.

# Anthropic API key for LLM extraction
ANTHROPIC_API_KEY=org_01kx32gvyffs981p5tdb2net7k

# Anthropic model (optional, defaults to claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Database URL (optional, defaults to local postgres)
DATABASE_URL=postgres://localhost:5432/rss_atlas?sslmode=disable